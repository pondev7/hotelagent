# HotelAgent configuration — every key the application reads.
#
# Invariant #9: all configuration through environment variables. Nothing reads
# os.environ directly; everything goes through Settings in
# apps/api/src/hotelagent/config.py. Every new key lands here, with a comment,
# in the same commit that introduces it.
#
# Copy to .env for local development. .env is gitignored — never commit secrets.

# --- Application ---------------------------------------------------------
# One of: local | staging | production
HOTELAGENT_ENV=local
# Emit human-readable logs locally, JSON in production.
HOTELAGENT_LOG_JSON=false
# Comma-separated origins allowed to call the API (the ops console).
HOTELAGENT_CORS_ORIGINS=http://localhost:3000

# --- Datastores ----------------------------------------------------------
# Async driver — asyncpg, not psycopg.
# "localhost" because host-side tooling (`make migrate`, pytest) runs outside
# the Compose network. Containers are given the in-network hostnames
# ("postgres", "redis") by docker-compose.yml, which override these values.
HOTELAGENT_DATABASE_URL=postgresql+asyncpg://hotelagent:hotelagent@localhost:5432/hotelagent
HOTELAGENT_REDIS_URL=redis://localhost:6379/0
# Integration tests use a separate database. "localhost" because pytest runs on
# the host, outside the Compose network where the service is named "postgres".
HOTELAGENT_TEST_DATABASE_URL=postgresql+asyncpg://hotelagent:hotelagent@localhost:5432/hotelagent_test
# Echo every SQL statement to the log. Handy while learning; noisy otherwise.
HOTELAGENT_DATABASE_ECHO=false

# --- Object storage (S3-compatible only: R2, S3 or MinIO) ----------------
# Left blank at slice 0; media handling arrives with the channel gateway.
HOTELAGENT_S3_ENDPOINT=
HOTELAGENT_S3_BUCKET=
HOTELAGENT_S3_ACCESS_KEY_ID=
HOTELAGENT_S3_SECRET_ACCESS_KEY=

# --- Postgres container (docker-compose only, not read by the app) -------
POSTGRES_USER=hotelagent
POSTGRES_PASSWORD=hotelagent
POSTGRES_DB=hotelagent

# --- Ops console ---------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Channel (WhatsApp) --------------------------------------------------
# "console" needs no Meta account and no public URL — the inbound flow is
# fully testable locally. Switch to "cloud_api" once Meta verification lands.
HOTELAGENT_CHANNEL_ADAPTER=console
# Meta app secret. Used to verify X-Hub-Signature-256 on every inbound
# webhook. Empty means no request can pass verification.
HOTELAGENT_WHATSAPP_APP_SECRET=
# Token echoed back during Meta's GET subscription handshake. Choose any
# long random string and paste the same value into the Meta app console.
HOTELAGENT_WHATSAPP_VERIFY_TOKEN=
# M1 runs one city; the gateway resolves city_id from this slug.
HOTELAGENT_DEFAULT_CITY_SLUG=kanyakumari
# Sending credentials from the Meta app. The access token is a secret and is
# never written to a log.
HOTELAGENT_WHATSAPP_ACCESS_TOKEN=
HOTELAGENT_WHATSAPP_PHONE_NUMBER_ID=
HOTELAGENT_WHATSAPP_API_BASE_URL=https://graph.facebook.com
HOTELAGENT_WHATSAPP_API_VERSION=v21.0

# --- Outbound HTTP -------------------------------------------------------
# Every outbound call is bounded; an untimed request can hang indefinitely.
HOTELAGENT_HTTP_TIMEOUT_SECONDS=10.0
# Total attempts, not retries: 3 means one try plus two retries.
HOTELAGENT_HTTP_MAX_ATTEMPTS=3
