# HotelAgent configuration — every key the application reads.
#
# Invariant #9: all configuration through environment variables. Nothing reads
# os.environ directly; everything goes through Settings in
# apps/api/src/hotelagent/config.py. Every new key lands here, with a comment,
# in the same commit that introduces it.
#
# Copy to .env for local development. .env is gitignored — never commit secrets.

# --- Application ---------------------------------------------------------
# One of: local | staging | production
HOTELAGENT_ENV=local
# Emit human-readable logs locally, JSON in production.
HOTELAGENT_LOG_JSON=false
# Comma-separated origins allowed to call the API (the ops console).
HOTELAGENT_CORS_ORIGINS=http://localhost:3000

# --- Datastores ----------------------------------------------------------
# Async driver — asyncpg, not psycopg. Host is the Compose service name.
HOTELAGENT_DATABASE_URL=postgresql+asyncpg://hotelagent:hotelagent@postgres:5432/hotelagent
HOTELAGENT_REDIS_URL=redis://redis:6379/0

# --- Object storage (S3-compatible only: R2, S3 or MinIO) ----------------
# Left blank at slice 0; media handling arrives with the channel gateway.
HOTELAGENT_S3_ENDPOINT=
HOTELAGENT_S3_BUCKET=
HOTELAGENT_S3_ACCESS_KEY_ID=
HOTELAGENT_S3_SECRET_ACCESS_KEY=

# --- Postgres container (docker-compose only, not read by the app) -------
POSTGRES_USER=hotelagent
POSTGRES_PASSWORD=hotelagent
POSTGRES_DB=hotelagent

# --- Ops console ---------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
